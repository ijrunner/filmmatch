DEFINE_UI_PARAMS(FM_MATCH_POWER_R, 匹配-幂次红 Match Power R, DCTLUI_SLIDER_FLOAT, 1.004262f, 0.700000f, 1.400000f, 0.001f)
DEFINE_UI_TOOLTIP(匹配-幂次红 Match Power R, "红通道幂次，1.0 为不变，大于 1 压暗中间调")
DEFINE_UI_PARAMS(FM_MATCH_POWER_G, 匹配-幂次绿 Match Power G, DCTLUI_SLIDER_FLOAT, 0.988403f, 0.700000f, 1.400000f, 0.001f)
DEFINE_UI_TOOLTIP(匹配-幂次绿 Match Power G, "绿通道幂次，1.0 为不变，大于 1 压暗中间调")
DEFINE_UI_PARAMS(FM_MATCH_POWER_B, 匹配-幂次蓝 Match Power B, DCTLUI_SLIDER_FLOAT, 0.995409f, 0.700000f, 1.400000f, 0.001f)
DEFINE_UI_TOOLTIP(匹配-幂次蓝 Match Power B, "蓝通道幂次，1.0 为不变，大于 1 压暗中间调")
DEFINE_UI_PARAMS(FM_MATCH_SAT, 匹配-饱和度 Match Saturation, DCTLUI_SLIDER_FLOAT, 1.000000f, 0.500000f, 2.000000f, 0.001f)
DEFINE_UI_TOOLTIP(匹配-饱和度 Match Saturation, "匹配段饱和度，1.0 为不变，绕亮度轴调整色彩浓度")

// ---- 内置工具（纯函数，DCTL 语法） ----
__DEVICE__ float fm_clamp01(float x) { return x < 0.0f ? 0.0f : (x > 1.0f ? 1.0f : x); }
__DEVICE__ float fm_mix(float a, float b, float t) { return a + (b - a) * t; }
__DEVICE__ float fm_fract(float x) { return x - _floorf(x); }
__DEVICE__ float3 fm_mix3(float3 a, float3 b, float t) {
    return make_float3(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t, a.z + (b.z - a.z) * t);
}
__DEVICE__ float3 fm_scale3(float3 v, float k) { return make_float3(v.x * k, v.y * k, v.z * k); }
__DEVICE__ float3 fm_add3(float3 a, float3 b) { return make_float3(a.x + b.x, a.y + b.y, a.z + b.z); }
__DEVICE__ float3 fm_mul3(float3 a, float3 b) { return make_float3(a.x * b.x, a.y * b.y, a.z * b.z); }
__DEVICE__ float fm_smoothstep(float a, float b, float x) {
    float t = fm_clamp01((x - a) / (b - a));
    return t * t * (3.0f - 2.0f * t);
}
__DEVICE__ float fm_luma(float3 c) { return 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z; }
__DEVICE__ float fm_max3(float3 c) { return _fmaxf(c.x, _fmaxf(c.y, c.z)); }
__DEVICE__ float3 fm_split_dir(float h) {
    float hh = fm_clamp01(h);
    float h6 = fm_fract(hh) * 6.0f;
    float i = _floorf(h6);
    float f = h6 - i;
    float q = 1.0f - f;
    float rr = 1.0f;
    float gg = 0.0f;
    float bb = 0.0f;
    if (i < 1.0f) { rr = 1.0f; gg = f; bb = 0.0f; }
    else if (i < 2.0f) { rr = q; gg = 1.0f; bb = 0.0f; }
    else if (i < 3.0f) { rr = 0.0f; gg = 1.0f; bb = f; }
    else if (i < 4.0f) { rr = 0.0f; gg = q; bb = 1.0f; }
    else if (i < 5.0f) { rr = f; gg = 0.0f; bb = 1.0f; }
    else { rr = 1.0f; gg = 0.0f; bb = q; }
    float ll = 0.2126f * rr + 0.7152f * gg + 0.0722f * bb;
    return make_float3(rr - ll, gg - ll, bb - ll);
}
__DEVICE__ int fm_clampi(int x, int n) { return x < 0 ? 0 : (x > n - 1 ? n - 1 : x); }
__DEVICE__ int fm_iround(float x) { return x < 0.0f ? (int)(x - 0.5f) : (int)(x + 0.5f); }
__DEVICE__ float fm_hash12(float px, float py, float k) {
    float x = fm_fract(px * 0.1031f);
    float y = fm_fract(py * 0.1031f);
    float z = fm_fract(k * 0.1031f);
    float d = x * (y + 33.33f) + y * (z + 33.33f) + z * (x + 33.33f);
    x = x + d; y = y + d; z = z + d;
    return fm_fract((x + y) * z);
}
__DEVICE__ float fm_vnoise(float px, float py, float k) {
    float ix = _floorf(px);
    float iy = _floorf(py);
    float fx = px - ix;
    float fy = py - iy;
    float ux = fx * fx * (3.0f - 2.0f * fx);
    float uy = fy * fy * (3.0f - 2.0f * fy);
    float a = fm_hash12(ix, iy, k);
    float bb = fm_hash12(ix + 1.0f, iy, k);
    float cc = fm_hash12(ix, iy + 1.0f, k);
    float dd = fm_hash12(ix + 1.0f, iy + 1.0f, k);
    return (a + (bb - a) * ux) * (1.0f - uy) + (cc + (dd - cc) * ux) * uy;
}

// ---- 匹配段：内联 CDL（逐式镜像 batch/cdl.applyCdl；系数与 R3 导出一致） ----
typedef struct { float sr, sg, sb, ofr, ofg, ofb, pr, pg, pb, sat; } FmMatchParams;
__DEVICE__ float fm_cdl_ch(float x, float s, float o, float p) {
    float base = x * s + o;
    if (base <= 0.0f) return 0.0f;   // 底数非正按 0 处理（与 cdl.ts 同规则：单调、无 NaN）
    return _powf(base, p);
}
__DEVICE__ float3 fm_apply_cdl(float3 c, FmMatchParams m) {
    float r = fm_cdl_ch(c.x, m.sr, m.ofr, m.pr);
    float g = fm_cdl_ch(c.y, m.sg, m.ofg, m.pg);
    float b = fm_cdl_ch(c.z, m.sb, m.ofb, m.pb);
    float l = 0.2126f * r + 0.7152f * g + 0.0722f * b;   // Rec.709 亮度（与 cdl.ts 同权重）
    return make_float3(fm_clamp01(l + m.sat * (r - l)),
                       fm_clamp01(l + m.sat * (g - l)),
                       fm_clamp01(l + m.sat * (b - l)));
}

// ---- 管线 TF：显示编码 ↔ 归一化对数域 x∈[0,1] ----
__DEVICE__ float fm_tf_encode(float v) {
    float L = _powf(fm_clamp01(v), 2.4f);                       // BT.1886 EOTF（简化幂律 2.4）
    float tt = _logf(L + 0.050625f) * 1.44269504f;  // log2（加黑位偏移保有限）
    return fm_clamp01((tt - (-4.304006f)) * 0.22855816f);                 // 归一化：0→0 / 0.18→0.5 / 1→1
}
__DEVICE__ float fm_tf_decode(float x) {
    float tt = (-4.304006f) + fm_clamp01(x) / 0.22855816f;
    float L = _fmaxf(_expf(tt * 0.69314718f) - 0.050625f, 0.0f);
    return fm_clamp01(_powf(L, 0.41666667f));                  // 1/2.4
}

// ---- 归一化对数域 look（与网页端 logmath.applyLogLook 同式） ----
__DEVICE__ float fm_soft_s(float x, float pivot, float s) {
    float p = fm_clamp01(pivot);
    float lo = p < 0.000001f ? 0.000001f : p;
    float hi = (1.0f - p) < 0.000001f ? 0.000001f : (1.0f - p);
    if (x <= p) {
        float u = fm_clamp01(x / lo);
        float su = u * u * (3.0f - 2.0f * u);
        return p * fm_mix(u, su, s);
    }
    float u = fm_clamp01((x - p) / hi);
    float su = u * u * (3.0f - 2.0f * u);
    return p + hi * fm_mix(u, su, s);
}
__DEVICE__ float fm_gamma_s(float x, float s) {
    float su = x * x * (3.0f - 2.0f * x);
    return fm_mix(x, su, s);
}
__DEVICE__ float fm_toe_shoulder(float x, float pivot, float toe, float shoulder) {
    float p = fm_clamp01(pivot);
    float y = x;
    if (toe > 0.000001f && y < p && p > 0.000001f) {
        float u = fm_clamp01(y / p);
        y = p * _powf(u, 1.0f / (1.0f + toe));
    }
    if (shoulder > 0.000001f && y > p && p < 0.999999f) {
        float u = fm_clamp01((y - p) / (1.0f - p));
        y = p + (1.0f - p) * (1.0f - _powf(1.0f - u, 1.0f + shoulder));
    }
    return y;
}
typedef struct { float pivot, contrast, film_s, gamma_contrast, toe, shoulder; } FmChannelParams;
typedef struct { float crosstalk, shadow_bias, highlight_bias, fade, saturation, warmth, split_sh_hue, split_sh_sat, split_hi_hue, split_hi_sat, split_balance; } FmLookParams;
__DEVICE__ float fm_look_channel(float x, FmChannelParams p) {
    float pivot = fm_clamp01(p.pivot);
    float y = pivot + (x - pivot) * p.contrast;
    y = fm_soft_s(y, pivot, p.film_s);
    y = fm_gamma_s(y, p.gamma_contrast);
    y = fm_toe_shoulder(y, pivot, p.toe, p.shoulder);
    return y;
}
__DEVICE__ float3 fm_log_look(float3 c, FmLookParams lp, FmChannelParams cp) {
    float3 y = make_float3(fm_look_channel(c.x, cp), fm_look_channel(c.y, cp), fm_look_channel(c.z, cp));
    // 染料串扰（通道交叉混合；k=0 恒等；R18 六系数为烘焙常量）
    float k = lp.crosstalk;
    float3 d;
    d.x = y.x * (1.0f - k) + y.y * (k * 0.55f) + y.z * (k * 0.30f);
    d.y = y.x * (k * 0.35f) + y.y * (1.0f - k * 0.8f) + y.z * (k * 0.45f);
    d.z = y.x * (k * 0.25f) + y.y * (k * 0.35f) + y.z * (1.0f - k * 1.6f);
    // 分通道反向偏置（暗部青蓝 / 高光暖黄，相对量）
    float l = fm_luma(d);
    float sh = _powf(fm_clamp01(1.0f - l), 2.2f);
    float hi = _powf(fm_clamp01(l), 2.2f);
    d.x = d.x + lp.shadow_bias * (-0.10f * sh) + lp.highlight_bias * (0.10f * hi);
    d.y = d.y + lp.shadow_bias * (0.02f * sh) + lp.highlight_bias * (0.08f * hi);
    d.z = d.z + lp.shadow_bias * (0.16f * sh) + lp.highlight_bias * (-0.18f * hi);
    // 分离色调（Schema v1.2）：暗部/高光色相方向 × 饱和度 × 亮度权重（sat=0 贡献为 0）
    float spB = _fminf(1.0f, _fmaxf(-1.0f, lp.split_balance));
    float spWS = sh * (1.0f - 0.5f * spB);
    float spWH = hi * (1.0f + 0.5f * spB);
    float3 sds = fm_split_dir(lp.split_sh_hue);
    float3 sdh = fm_split_dir(lp.split_hi_hue);
    float sss = 0.2f * lp.split_sh_sat * spWS;
    float shs = 0.2f * lp.split_hi_sat * spWH;
    d.x = d.x + sds.x * sss + sdh.x * shs;
    d.y = d.y + sds.y * sss + sdh.y * shs;
    d.z = d.z + sds.z * sss + sdh.z * shs;
    // 褪色：黑位提升 + 白位收拢（R18：锚点重标定的对数域黑位以常量 black_extra 烘焙，默认 0 不出现）
    float blk = lp.fade * 0.10f;
    float wht = lp.fade * 0.08f;
    d = make_float3(blk + fm_clamp01(d.x) * (1.0f - blk - wht),
                    blk + fm_clamp01(d.y) * (1.0f - blk - wht),
                    blk + fm_clamp01(d.z) * (1.0f - blk - wht));
    // 饱和度 + 冷暖
    float l2 = fm_luma(d);
    d = make_float3(l2 + (d.x - l2) * lp.saturation,
                    l2 + (d.y - l2) * lp.saturation,
                    l2 + (d.z - l2) * lp.saturation);
    d = make_float3(d.x * (1.0f + lp.warmth * 0.05f),
                    d.y * (1.0f + lp.warmth * 0.01f),
                    d.z * (1.0f - lp.warmth * 0.05f));
    return make_float3(fm_clamp01(d.x), fm_clamp01(d.y), fm_clamp01(d.z));
}

// ---- 邻域 tap 的逐点 look（R21）：与中心像素同链路，阈值作用于 look 后的图 ----
__DEVICE__ float3 fm_tap_look(float3 s, FmMatchParams mp, float tm, FmLookParams lp, FmChannelParams cp) {
    if (tm > 0.5f) { s = fm_apply_cdl(s, mp); }   // 匹配段与中心像素同式（开关关闭则跳过）
    float3 e = make_float3(fm_tf_encode(s.x), fm_tf_encode(s.y), fm_tf_encode(s.z));
    e = fm_log_look(e, lp, cp);
    return make_float3(fm_tf_decode(e.x), fm_tf_decode(e.y), fm_tf_decode(e.z));
}

__DEVICE__ float3 transform(int p_Width, int p_Height, int p_X, int p_Y, __TEXTURE__ p_TexR, __TEXTURE__ p_TexG, __TEXTURE__ p_TexB)
{
    float hs = (float)p_Height / 1080.0f;   // 空间量运行时缩放基准（滑杆为 1080p 基准 px）
    float wx = 0.0f;
    float wy = 0.0f;
    float wSec = (float)TIMELINE_FRAME_INDEX / 24.0f;   // 秒（24fps 基准）
    float wPh = 6.28318531f * FM_GATE_WEAVE_SPEED * wSec;
    float wPx = (float)FM_GATE_WEAVE_PX * hs;   // 位移 px（1080p 基准，按高度缩放）
    wx = wPx * _sinf(wPh);
    wy = wPx * 0.6f * _sinf(wPh * 1.37f + 1.7f);   // 垂直分量 0.6 / 频率比 1.37 / 相位 1.7
    int cx = fm_clampi(p_X + fm_iround(wx), p_Width);
    int cy = fm_clampi(p_Y + fm_iround(wy), p_Height);
    float wf = (float)p_Width;
    float hf = (float)p_Height;
    float cuvx = (float)p_X / wf - 0.5f;
    float cuvy = (float)p_Y / hf - 0.5f;
    float len = _sqrtf(cuvx * cuvx + cuvy * cuvy);
    float rr = len * 1.41421356f;   // 0 中心 → 1 角落
    // 边缘色散：R 外移 / B 内移（与网页管线同序，先于 look）；px 按高度运行时缩放
    float caPx = FM_VIGNETTE_CHROMA_PX * hs * rr * rr;
    float cax = len > 0.0001f ? cuvx / len * caPx : 0.0f;
    float cay = len > 0.0001f ? cuvy / len * caPx : 0.0f;
    int rx = fm_clampi(cx - fm_iround(cax), p_Width);
    int ry = fm_clampi(cy - fm_iround(cay), p_Height);
    int bx = fm_clampi(cx + fm_iround(cax), p_Width);
    int by = fm_clampi(cy + fm_iround(cay), p_Height);
    float3 src = make_float3(_tex2D(p_TexR, rx, ry), _tex2D(p_TexG, cx, cy), _tex2D(p_TexB, bx, by));

    // ---- 匹配段：内联 CDL（与 R3 导出系数一致，可在面板微调） ----
    FmMatchParams mp;
    mp.sr = FM_MATCH_SLOPE_R; mp.sg = FM_MATCH_SLOPE_G; mp.sb = FM_MATCH_SLOPE_B;
    mp.ofr = FM_MATCH_OFFSET_R; mp.ofg = FM_MATCH_OFFSET_G; mp.ofb = FM_MATCH_OFFSET_B;
    mp.pr = FM_MATCH_POWER_R; mp.pg = FM_MATCH_POWER_G; mp.pb = FM_MATCH_POWER_B;
    mp.sat = FM_MATCH_SAT;
    float tm = FM_MATCH_ON > 0.5f ? 1.0f : 0.0f;   // 匹配开关的 0/1 值（tap 侧逐点复用）
    if (FM_MATCH_ON > 0.5f) {
        src = fm_apply_cdl(src, mp);
    }

    // ---- 归一化对数域 look ----
    float3 c = make_float3(fm_tf_encode(src.x), fm_tf_encode(src.y), fm_tf_encode(src.z));
    FmChannelParams cp;
    cp.pivot = FM_PIVOT; cp.contrast = FM_CONTRAST; cp.film_s = FM_FILM_S;
    cp.gamma_contrast = FM_GAMMA_CONTRAST; cp.toe = FM_TOE; cp.shoulder = FM_SHOULDER;
    FmLookParams lp;
    lp.crosstalk = FM_CROSSTALK; lp.shadow_bias = FM_SHADOW_BIAS; lp.highlight_bias = FM_HIGHLIGHT_BIAS;
    lp.fade = FM_FADE; lp.saturation = FM_SATURATION; lp.warmth = FM_WARMTH;
    lp.split_sh_hue = FM_SPLIT_SHADOW_HUE; lp.split_sh_sat = FM_SPLIT_SHADOW_SAT;
    lp.split_hi_hue = FM_SPLIT_HIGHLIGHT_HUE; lp.split_hi_sat = FM_SPLIT_HIGHLIGHT_SAT;
    lp.split_balance = FM_SPLIT_BALANCE;
    c = fm_log_look(c, lp, cp);
    c = make_float3(fm_tf_decode(c.x), fm_tf_decode(c.y), fm_tf_decode(c.z));
    float bgL = fm_luma(c);   // 背景亮度（未叠加效果前）：增益类参数按它算

    // ---- 光晕：紧晕 3×3 + 宽晕双环（R21）；亮通逐 tap 过完整 look（与网页端同作用域） ----
    float3 hal = make_float3(0.0f, 0.0f, 0.0f);
    if (FM_HALATION_ON > 0.5f) {
        // 半径运行时缩放：1080p 基准时间线上与旧固化常量逐位一致（fm_iround(x·1.0f) = x）
        int rt = fm_iround((float)FM_HALATION_TIGHT_PX * hs);
        int rw = fm_iround((float)FM_HALATION_RADIUS_PX * hs);
        float lumT = 0.0f;   // 紧晕亮通权重累积（标量；晕色由 tint 决定）
        float lumW = 0.0f;   // 宽晕亮通权重累积
        float wT = 0.0f;
        float wW = 0.0f;
        // 紧晕 3×3@rt（3px @1080p 基准，pow=1 保高光形状）
        {
            int xx = fm_clampi(cx + (-1 * rt), p_Width);
            int yy = fm_clampi(cy + (-1 * rt), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv);
            float gw = 0.018316f;
            lumT = lumT + bw * gw;
            wT = wT + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (-1 * rt), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumT = lumT + bw * gw;
            wT = wT + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * rt), p_Width);
            int yy = fm_clampi(cy + (-1 * rt), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv);
            float gw = 0.018316f;
            lumT = lumT + bw * gw;
            wT = wT + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * rt), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumT = lumT + bw * gw;
            wT = wT + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv);
            float gw = 1.000000f;
            lumT = lumT + bw * gw;
            wT = wT + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * rt), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
