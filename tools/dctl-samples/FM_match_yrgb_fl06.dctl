            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * rw), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 1.000000f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * rw), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * rw), p_Width);
            int yy = fm_clampi(cy + (1 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (1 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * rw), p_Width);
            int yy = fm_clampi(cy + (1 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * 2 * rw), p_Width);
            int yy = fm_clampi(cy + (-1 * 2 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (-1 * 2 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * 2 * rw), p_Width);
            int yy = fm_clampi(cy + (-1 * 2 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * 2 * rw), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * 2 * rw), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * 2 * rw), p_Width);
            int yy = fm_clampi(cy + (1 * 2 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (1 * 2 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * 2 * rw), p_Width);
            int yy = fm_clampi(cy + (1 * 2 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.018316f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        lumT = lumT / _fmaxf(wT, 0.0001f);
        lumW = lumW / _fmaxf(wW, 0.0001f);
        // 紧/宽权重分配（与 effectmath.halationWeights 同式，含 R21 master；amplify 只改配比不改不透明度）
        float halA = fm_clamp01(FM_HALATION_AMPLIFY / 2.0f);
        float halS = fm_clamp01(FM_HALATION_SMOOTH);
        float halBase = 1.6000f * FM_HALATION_AMOUNT * FM_MASTER * FM_HALATION_IMPACT;
        float halWf = _fminf(0.85f, _fmaxf(0.10f, 0.46875f + 0.20f * (halA - 0.5f) + 0.10f * (halS - 0.5f)));
        float halV = lumT * halBase * (1.0f - halWf) + lumW * halBase * halWf;   // 标量晕强度（亮通权重均值 × tint 上色）
        // 晕染色：hue 调绿层灵敏度、amplify 抬绿增益（与 effectmath 同式）；颜色由 tint 决定
        float tintG = 0.6f + 0.8f * FM_HALATION_HUE;
        float tintB = 1.0f - 0.8f * _fabs(FM_HALATION_HUE - 0.5f);
        float tintA = 0.85f + 0.3f * fm_clamp01(FM_HALATION_AMPLIFY / 2.0f);
        float3 tint = make_float3(FM_HALATION_TINT_R, fm_clamp01(FM_HALATION_TINT_G * tintG) * tintA, fm_clamp01(FM_HALATION_TINT_B * tintB));
        hal = make_float3(fm_clamp01(halV * tint.x), fm_clamp01(halV * tint.y), fm_clamp01(halV * tint.z));
        // 暗部保护：远场软衰减 + 亮背景压制 + 冷背景补偿
        float halProt = fm_smoothstep(0.004f, 0.035f, fm_max3(hal));
        float halBg = 1.0f - (1.0f - fm_clamp01(FM_HALATION_BG_GAIN)) * fm_smoothstep(0.30f, 0.85f, bgL);
        float halBlue = 1.0f + fm_clamp01(FM_HALATION_BLUE_COMP) * 0.8f * fm_clamp01((c.z - c.x) / 0.35f);
        hal = fm_scale3(hal, halProt * halBg * halBlue);
        c = make_float3(1.0f - (1.0f - c.x) * (1.0f - hal.x),
                        1.0f - (1.0f - c.y) * (1.0f - hal.y),
                        1.0f - (1.0f - c.z) * (1.0f - hal.z));
    }

    // ---- 柔光 bloom（R21 双环：中心 + 4@r + 4@2r；亮通逐 tap 过完整 look，按亮度阈值） ----
    if (FM_BLOOM_ON > 0.5f) {
        int rb = fm_iround((float)FM_BLOOM_RADIUS_PX * hs);   // 半径运行时缩放（1080p 基准时间线 = 原值）
        float3 lumB = make_float3(0.0f, 0.0f, 0.0f);   // 柔光彩色累积（look 后源色）
        float wB = 0.0f;
        // 柔光双环：中心 + 内环 4@rb + 外环 4@2rb（19px @1080p 基准，details 分配大小光源）
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 1.000000f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * rb), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * rb), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (-1 * rb), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (1 * rb), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (-1 * 2 * rb), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * 2 * rb), p_Width);
            int yy = fm_clampi(cy + (0), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (-1 * 2 * rb), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        {
            int xx = fm_clampi(cx + (0), p_Width);
            int yy = fm_clampi(cy + (1 * 2 * rb), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
            float lb = _tex2D(p_TexB, xx, yy);
            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_luma(lk);   // 亮通按亮度（网页端柔光 useMax=0）
            float bw = fm_smoothstep(FM_BLOOM_THRESHOLD, 1.0f, lv);
            float gw = 0.135335f;
            lumB = fm_add3(lumB, fm_scale3(lk, bw * gw));
            wB = wB + gw;
        }
        float blmK = (1.0f / _fmaxf(wB, 0.0001f)) * FM_BLOOM_AMOUNT * FM_MASTER;
        float3 blm = fm_scale3(lumB, blmK);   // 彩色柔光（带源色）
        float blmL = fm_luma(blm);
        blm = make_float3(blmL + (blm.x - blmL) * FM_BLOOM_SATURATION,
                          blmL + (blm.y - blmL) * FM_BLOOM_SATURATION,
                          blmL + (blm.z - blmL) * FM_BLOOM_SATURATION);
        blm = fm_scale3(blm, 1.0f - fm_clamp01(FM_BLOOM_SAVE_LIGHTS) * fm_smoothstep(0.75f, 1.0f, bgL));
        c = make_float3(1.0f - (1.0f - c.x) * (1.0f - fm_clamp01(blm.x)),
                        1.0f - (1.0f - c.y) * (1.0f - fm_clamp01(blm.y)),
                        1.0f - (1.0f - c.z) * (1.0f - fm_clamp01(blm.z)));
    }

    // ---- 暗角（中心不动，向角落平滑加深；强度乘 master 并按 1 封顶——与网页端 u_vigAmt 同式） ----
    if (FM_VIGNETTE_ON > 0.5f) {
        float vig = 1.0f - _fminf(1.0f, FM_VIGNETTE_AMOUNT * FM_MASTER) * fm_smoothstep(FM_VIGNETTE_RADIUS * 0.707f - 0.35f, 1.0f, rr);
        c = fm_scale3(c, vig);
    }

    // ---- 颗粒（R9 动态：相位由 TIMELINE_FRAME_INDEX 逐帧步进，同一乳剂平移 + 微扰动） ----
    if (FM_GRAIN_ON > 0.5f) {
        float grainPx = _fmaxf(FM_GRAIN_SIZE_PX * hs, 1.0f);   // 间距 px（1080p 基准，按高度缩放）
        float gx = (float)p_X / grainPx;
        float gy = (float)p_Y / grainPx;
        // 逐帧相位：黄金比步进 + 两个微扰动（逐帧不同，但非每帧完全无关——同一乳剂在动）
        float ph = (float)TIMELINE_FRAME_INDEX * 0.61803399f;
        float jx = ph * 0.137f + 0.02f * fm_fract(ph * 0.719f);
        float jy = ph * 0.211f + 0.02f * fm_fract(ph * 0.913f);
        // 金字塔尺度权重（由有效尺寸/乳剂分辨率推导）：粗 0.2703f 中 0.4200f 细 0.3097f
        float mono = (fm_vnoise((gx + jx) * 0.5f, (gy + jy) * 0.5f, 0.0f) * 0.2703f
                    + fm_vnoise((gx + jx), (gy + jy), 17.13f) * 0.4200f
                    + fm_vnoise((gx + jx) * 1.9f, (gy + jy) * 1.9f, 31.71f) * 0.3097f - 0.5f) * 2.1f;
        float cr = fm_hash12((gx + jx) * 1.7f, (gy + jy) * 1.7f, 51.7f) - 0.5f;
        float cg = fm_hash12((gx + jx) * 1.7f, (gy + jy) * 1.7f, 67.3f) - 0.5f;
        float cb = fm_hash12((gx + jx) * 1.7f, (gy + jy) * 1.7f, 83.9f) - 0.5f;
        float3 gnoise = fm_mix3(make_float3(cr * 0.7f, cg * 0.7f, cb * 0.7f), make_float3(mono, mono, mono), FM_GRAIN_CORRELATION);
        // 扫描颗粒团簇：低频噪声决定团块处颗粒更重
        float clLow = fm_vnoise(gx * 0.18f, gy * 0.18f, 91.7f);
        float clGain = 1.0f + FM_GRAIN_CLUSTER * (clLow - 0.5f) * 2.0f * 0.6f;   // cluster=0 → 恒等 1
        // 亮度三段包络（三段和恒为 1）
        float gl = fm_luma(c);
        float bSh = 1.0f - fm_smoothstep(0.0f, 0.43f, gl);
        float bHi = fm_smoothstep(0.43f, 0.85f, gl);
        float bMid = 1.0f - bSh - bHi;
        float gW = bSh * FM_GRAIN_SHADOW + bMid * FM_GRAIN_MIDTONE + bHi * FM_GRAIN_HIGHLIGHT;
        c = fm_add3(c, fm_scale3(gnoise, FM_GRAIN_AMP * FM_MASTER * gW * clGain));   // 幅度乘 master（与网页端 u_grainAmp 同式）
    }
    return make_float3(fm_clamp01(c.x), fm_clamp01(c.y), fm_clamp01(c.z));
}
