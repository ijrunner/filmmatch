            lumT = lumT + bw * gw;
            wT = wT + gw;
        }
        // 宽晕双环：内环 3×3@rw + 外环 8@2rw（16px @1080p 基准，pow=2 → 越亮晕越铺开；外环不重复采中心）
        {
            int xx = fm_clampi(cx + (-1 * rw), p_Width);
            int yy = fm_clampi(cy + (-1 * rw), p_Height);
            float lr = _tex2D(p_TexR, xx, yy);
            float lg = _tex2D(p_TexG, xx, yy);
