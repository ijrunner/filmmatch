            float3 lk = fm_tap_look(make_float3(lr, lg, lb), mp, tm, lp, cp);   // 邻域点过完整链路（与中心像素同式）
            float lv = fm_max3(lk);   // 亮通按最大通道（网页端光晕 useMax=1）
            float bw = _powf(fm_smoothstep(FM_HALATION_THRESHOLD, 1.0f, lv), 2.0f);
            float gw = 0.135335f;
            lumW = lumW + bw * gw;
            wW = wW + gw;
        }
        {
            int xx = fm_clampi(cx + (1 * rw), p_Width);
            int yy = fm_clampi(cy + (-1 * rw), p_Height);
